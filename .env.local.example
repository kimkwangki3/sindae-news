# Supabase — 프로젝트 생성 후 Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 서버 전용(관리자 작업). 절대 클라이언트 노출 금지

# 사이트 기본 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Supabase Auth에서 카카오 OAuth 설정 — 키는 Supabase 대시보드에 등록, 코드 노출 불필요)

# 익명 IP 해시 솔트(반응·조회 중복 방지). 운영에서 반드시 설정
IP_HASH_SALT=

# 텔레그램 알림 — 신규 신청·제보·신고를 개인 채팅으로 수신. 서버 전용.
# 둘 중 하나라도 비어 있으면 알림은 조용히 건너뛴다(기능은 정상 동작).
# 토큰: @BotFather → /newbot  |  chat_id: 봇에게 /start 후 @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
